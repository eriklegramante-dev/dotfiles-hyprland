// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-bottom": 0,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
        "custom/wallpaper",
        "pulseaudio",
        "cpu",
        "memory",
        "battery",
        "clock",
        "custom/power",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "persistent-workspaces": {
            "*": 5
        },
        "format-icons": {
            "1": "󰈹",
            "2": "󰨞",
            "3": "󰆍",
            "4": "󰓇",
            "5": "󰖗",
            "urgent": "󰵅",
            "active": "󰮯",
            "default": "󰍹"
        }
    },

    "hyprland/window": {
        "format": "󰣆 {title}",
        "max-length": 45,
        "separate-outputs": true
    },
    
    "custom/wallpaper": {
        "format": "󰸉",
        "tooltip-format": "Change Wallpaper",
        "on-click": "/home/sob/.config/hypr/scripts/wallpaper.sh"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%  {format_source}",
        "format-bluetooth": "󰂰 {volume}%  {format_source}",
        "format-bluetooth-muted": "󰂲  {format_source}",
        "format-muted": "󰝟  {format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰄝",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 2,
        "on-click": "pavucontrol"
    },

    "cpu": {
        "interval": 2,
        "format": "󰍛 {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": "󰘚 {}%"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "clock": {
        "timezone": "America/Sao_Paulo",
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%a, %d %b %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><big>{calendar}</big></tt>"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "nwg-bar"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}